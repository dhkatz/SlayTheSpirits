<Project>
  <!-- Central package management: versions live here, projects reference without versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="ILRepack" Version="2.0.48" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Must match the game's Godot version (GodotSharp.dll in data_sts2_*). -->
    <PackageVersion Include="Godot.SourceGenerators" Version="4.5.1" />
  </ItemGroup>
</Project>
