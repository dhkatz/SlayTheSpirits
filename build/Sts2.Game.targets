<Project>
  <!--
    Compile-time references to the installed game. Never copied to output (Private=false):
    at runtime the game supplies these assemblies itself.
  -->
  <Target Name="Sts2ValidateGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(Sts2GameDir)' == ''"
           Text="Couldn't find Slay the Spire 2 in your Steam libraries. Set the STS2_GAME_DIR environment variable, or copy local.props.example to local.props (repo root) and set Sts2GameDir." />
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')"
           Text="sts2.dll not found under '$(Sts2DataDir)'. Check the game folder set by $(Sts2GameDirSource)." />
  </Target>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)\GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="false" />
    <Reference Include="SmartFormat" HintPath="$(Sts2DataDir)\SmartFormat.dll" Private="false" />
  </ItemGroup>

  <!--
    Godot's C# source generators, so SDK and mod code can define Godot node classes (custom controls).
    Godot discovers a class's methods, signals and properties through generated code; without it, overrides
    such as _Ready never run. Mod classes are created with `new` and get a path-less script, so:
      ScriptPathAttribute      off: no res:// script files exist for mod code (and it needs a Godot project dir).
      GodotPluginsInitializer  off: that is the game's own entry point, not ours.
  -->
  <ItemGroup>
    <PackageReference Include="Godot.SourceGenerators" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <GodotDisabledSourceGenerators>ScriptPathAttribute;GodotPluginsInitializer</GodotDisabledSourceGenerators>
  </PropertyGroup>

  <!--
    Game commands that throw when handed the wrong kind of model (canonical or a player's copy) are banned (RS0030);
    SpireKit.Runs.SpireCmd wraps them so either kind works.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(BuildDir)BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Game code is not annotated for our analyzers; keep strictness for our code without drowning in noise. -->
    <NoWarn>$(NoWarn);CA1848;CA2007</NoWarn>
  </PropertyGroup>
</Project>
