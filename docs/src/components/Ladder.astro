---
// The drink ladder, lightest first: one rung per drink, with its default name, what to do and the Tipsy it adds, all
// from the rules engine. Each links to its keyword page.
import { asset, drinks, refs } from '../lib/data';
---

<ol class="sts-ladder not-content">
	{
		drinks.map((drink, rung) => (
			<li class={`sts-ladder__rung sts-drink--${rung}`}>
				{drink.icon && <img src={asset(drink.icon)} alt="" loading="lazy" />}
				<p class="sts-ladder__name" set:html={refs.ref('keyword', drink.slug, { icon: false })} />
				<p class="sts-ladder__what">{drink.searchText.replace(/ Gain \d+ Tipsy\.$/, '')}</p>
				<p class="sts-ladder__tipsy">{(drink.tipsy ?? 0) > 0 ? `+${drink.tipsy} Tipsy` : 'No Tipsy'}</p>
			</li>
		))
	}
</ol>
